{
    "version": 3,
    "configurePresets": [
        {
            "name": "Debug",
            "displayName": "MSVC + Ninja x64 (Debug)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "ENABLE_LOGWM": "ON",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "cl",
                "ENABLE_LOGDS": "OFF"
            }
        },
        {
            "name": "MSVC + Ninja x64 (Debug-dev)",
            "inherits": "Debug",
            "binaryDir": "${sourceDir}/build/debug-dev",
            "cacheVariables": {
                "ENABLE_LOCALFILES": "ON",
                "ENABLE_GDIDRAW": "OFF",
                "ENABLE_TESTMODE": "OFF",
                "ENABLE_GPUGRAPHRECT": "OFF",
                "ENABLE_LOGWM": "ON",
                "ENABLE_LOGFPS": "OFF",
                "ENABLE_LOGVRR": "OFF",
                "ENABLE_LOGDS": "OFF"
            }
        },
        {
            "name": "Release",
            "displayName": "MSVC + Ninja x64 (Release)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "cl"
            }
        }
    ]
}